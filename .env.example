# 복사해서 .env 로 사용하세요:  cp .env.example .env  (.env 는 git 에 올라가지 않습니다)
DB_ROOT_PASSWORD=change-me-root
DB_USER=manager
DB_PASSWORD=change-me

# 서비스 간(/internal/**) 호출 토큰. 임의의 긴 문자열로 바꾸세요 (예: openssl rand -hex 32)
INTERNAL_API_TOKEN=change-me-internal

# 주의: 이 값들은 학습·시연용 예시입니다. 과거 커밋 히스토리에는 예전 기본 비밀번호(SqlDba-1)가 남아 있으므로,
# 그 값은 어디에서도 재사용하지 마세요. 각 서비스 application.yml 의 datasource 기본값도
# 로컬 bootRun 편의용이며, Docker 실행 시에는 위 .env 값이 환경변수로 덮어씁니다.
